<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f6f9fc;">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f6f9fc; font-family: Arial, sans-serif;">
        <tr>
            <td align="center" style="padding: 40px 0;">
                <table cellpadding="0" cellspacing="0" border="0" width="600" style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                    <tr>
                        <td style="padding: 40px 40px 30px 40px; text-align: center; border-bottom: 1px solid #e5e7eb;">
                            <h1 style="margin: 0; font-size: 28px; color: #4f46e5; font-weight: bold;">{{title}}</h1>
                            {{#if subtitle}}
                            <p style="margin: 10px 0 0 0; color: #64748b; font-size: 16px;">{{subtitle}}</p>
                            {{/if}}
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 30px 40px;">
                            <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                {{#each fields}}
                                <tr>
                                    <td style="padding: 15px; margin-bottom: 20px; background-color: #f8fafc; border: 1px solid #e5e7eb; border-radius: 6px;">
                                        <strong style="display: block; margin-bottom: 8px; color: #4f46e5; font-size: 14px; text-transform: uppercase;">{{@key}}</strong>
                                        <div style="color: #1a202c; font-size: 16px;">{{{this}}}</div>
                                    </td>
                                </tr>
                                <tr><td height="20"></td></tr>
                                {{/each}}
                            </table>

                            {{#if products}}
                            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top: 20px;">
                                <tr>
                                    <td style="padding: 15px; background-color: #f8fafc; border: 1px solid #e5e7eb; border-radius: 6px;">
                                        <strong style="display: block; margin-bottom: 15px; color: #4f46e5; font-size: 14px; text-transform: uppercase;">Products</strong>
                                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <!-- Product Headers -->
                                            <tr>
                                                {{#each products.headers}}
                                                <th style="padding: 10px; text-align: left; border-bottom: 2px solid #e5e7eb; color: #1a202c; font-size: 14px;">{{this}}</th>
                                                {{/each}}
                                            </tr>
                                            <!-- Product Rows -->
                                            {{#each products.items}}
                                            <tr>
                                                {{#each this}}
                                                <td style="padding: 10px; border-bottom: 1px solid #e5e7eb; color: #4b5563; font-size: 14px;">{{{this}}}</td>
                                                {{/each}}
                                            </tr>
                                            {{/each}}
                                        </table>
                                    </td>
                                </tr>
                            </table>
                            {{/if}}
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 30px 40px; text-align: center; border-top: 1px solid #e5e7eb;">
                            {{#if footerText}}
                            <p style="margin: 0 0 10px 0; color: #64748b; font-size: 14px;">{{footerText}}</p>
                            {{/if}}
                            <p style="margin: 0; color: #64748b; font-size: 14px;">&copy; {{year}} ZAM Applications. All rights reserved.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>